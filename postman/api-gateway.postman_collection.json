{
  "info": {
    "_postman_id": "a2c94062-19df-4d7a-b1fd-a52ba4685201",
    "name": "api-gateway - smoke tests",
    "description": "Read-only smoke tests for the API Gateway routes. Start Eureka and register the four business services before running. Set baseUrl to the Gateway URL. These requests do not create or modify business data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Check API Gateway health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Gateway health endpoint returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Gateway health status is UP', () => pm.expect(pm.response.json().status).to.equal('UP'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "01 - Route to customer-service",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer route returns 200', () => pm.response.to.have.status(200));",
              "pm.test('Customer response is a JSON array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/customers?status=ALL&page=0&size=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "customers"
          ],
          "query": [
            {
              "key": "status",
              "value": "ALL"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "5"
            }
          ]
        }
      },
      "response": []
    },
